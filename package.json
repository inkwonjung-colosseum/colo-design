{
  "name": "cds-design",
  "private": true,
  "version": "0.2.0",
  "description": "Turns a planning document into working screens built from the company design system, in a chat a planner can use. Each user runs their own daemon and signs in with their own Claude subscription.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:daemon": "pnpm --filter @cds-design/daemon dev",
    "dev:web": "pnpm --filter @cds-design/web dev",
    "doctor": "pnpm --filter @cds-design/daemon doctor",
    "test:daemon": "node packages/daemon/test/e2e.mjs",
    "test": "node scripts/test-parallel.mjs",
    "test:sequential": "pnpm test:unit && pnpm test:onboard-unit && pnpm test:projects && pnpm test:repo && pnpm test:publish && pnpm test:publish-ui && pnpm test:settings && pnpm test:sidebar-ui && pnpm test:onboarding && pnpm test:onboarding-ui && pnpm test:daemon && pnpm test:planner && pnpm test:comments-ui && pnpm test:desktop-unit",
    "test:smoke": "node packages/web/test/smoke-live.mjs",
    "test:settings": "node packages/web/test/ui-settings-e2e.mjs",
    "test:sidebar-ui": "node packages/web/test/ui-sidebar-e2e.mjs",
    "test:unit": "node --test packages/daemon/test/platform.test.mjs packages/daemon/test/security.test.mjs packages/daemon/test/workspaces.test.mjs packages/daemon/test/home-dir.test.mjs && pnpm test:repo-unit && pnpm test:web-unit",
    "test:repo-unit": "node --test --test-force-exit packages/daemon/test/repo.test.mjs packages/daemon/test/github.test.mjs packages/daemon/test/translate.test.mjs packages/daemon/test/preview-tools.test.mjs",
    "test:web-unit": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test packages/web/test/handoff-draft.test.mts packages/web/test/session-activity.test.mts packages/web/test/turn-marker.test.mts packages/web/test/naming.test.mts packages/web/test/preview-address.test.mts",
    "test:onboard-unit": "node --test packages/daemon/test/onboarding.test.mjs packages/daemon/test/credentials.test.mjs",
    "test:projects": "node packages/daemon/test/projects-e2e.mjs",
    "test:repo": "node packages/daemon/test/repo-e2e.mjs",
    "test:publish": "node packages/daemon/test/publish-e2e.mjs",
    "test:publish-ui": "node packages/web/test/ui-publish-e2e.mjs",
    "test:onboarding": "node packages/daemon/test/onboarding-e2e.mjs",
    "test:onboarding-ui": "node packages/web/test/ui-onboarding-e2e.mjs",
    "test:planner": "node packages/web/test/ui-planner-e2e.mjs",
    "test:comments-ui": "node packages/desktop/test/desktop-comments.mjs",
    "test:desktop-unit": "node --test packages/desktop/test/desktop.test.mjs",
    "test:desktop-smoke": "node packages/desktop/test/desktop-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright": "1.62.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@11.20.0"
}
