{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/daemon": {
      "entry": ["test/**/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.mjs"],
      "ignoreBinaries": ["pkill"]
    },
    "packages/desktop": {
      "entry": ["src/preload.ts", "src/preview-preload.ts", "test/**/*.mjs", "scripts/**/*.mjs"],
      "project": ["src/**/*.ts", "test/**/*.mjs", "scripts/**/*.mjs"]
    },
    "packages/web": {
      "entry": [
        "index.html",
        "chatpreview.html",
        "journeypreview.html",
        "src/chat-preview.tsx",
        "src/journey-preview.tsx",
        "test/**/*.{mjs,mts}"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{mjs,mts}"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    }
  }
}
