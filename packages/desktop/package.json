{
  "name": "@nova-design/desktop",
  "productName": "Nova Design",
  "version": "0.3.15",
  "private": true,
  "description": "Nova Design 데스크톱 앱 — Electron 메인이 데몬을 in-process 로 호스팅하고 웹 UI를 함께 띄운다.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/build-preloads.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "dev:hmr": "node scripts/dev.mjs --hmr",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@nova-design/daemon": "workspace:*",
    "@nova-design/protocol": "workspace:*"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "@types/node": "^22.15.3"
  }
}
